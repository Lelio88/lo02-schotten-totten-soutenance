@startuml sequence-evaluation-borne
' Détail référencé par le diagramme principal : évaluation d'une borne (patron Visiteur).
title Évaluation d'une borne (patron Visiteur)

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam sequence {
  ParticipantBackgroundColor #F7EFD8
  ParticipantBorderColor #5A3A1B
  LifeLineBorderColor #5A3A1B
  ArrowColor #5A3A1B
}
skinparam participant<<visiteur>> {
  BackgroundColor #FFE599
}

participant "b : Borne" as B
participant "ev : EvaluateurCombinaison" as E <<visiteur>>
participant "c : Carte" as C

B -> B : evaluerGagnant()
B -> E ** : new
loop pour chaque joueur
  B -> B : getCartesJoueur(j)
  B -> E : evaluer(cartes)
  activate E
  loop pour chaque carte de la formation
    E -> C : accepter(ev)
    activate C
    C -> E : visiter(this)
    note right : Le type réel de la carte\n(CarteClan, TroupeElite...)\ndétermine la méthode visiter\nappelée
    deactivate C
  end
  E --> B : combinaison (SUITE_COULEUR, BRELAN, ...)
  deactivate E
end
alt la formation de j est strictement plus forte
  B -> B : revendiqueePar = j
else égalité de combinaison
  note over B : Départage par la somme,\npuis par le 1er joueur à avoir\nposé 3 cartes
end
@enduml
